# Copy to .env.local. Never commit .env.local. Never put a private key here.

# Absolute base URL used in quotes and receipts. Optional in dev.
# PITCH402_BASE_URL=http://localhost:3000

# Address that receives USDC payments (the curator's payout address).
# Required before x402 payments can be quoted for real.
PITCH402_PAY_TO=

# Set to 1 to allow the X-PITCH402-FAKE-PAY demo header in production.
# Leave unset. Fake pay is on by default in development only.
# PITCH402_ALLOW_FAKE_PAY=
