# Copy to .env.local. Never commit .env.local. Never put a private key here.

# Absolute base URL used in quotes and receipts. Optional in dev.
# PITCH402_BASE_URL=http://localhost:3000

# Address that receives USDC payments (the curator's payout address).
# Required before x402 payments can be quoted for real.
# The same EVM address works on Base Sepolia and HashKey Chain Testnet.
PITCH402_PAY_TO=

# Set to 1 to allow the X-PITCH402-FAKE-PAY demo header in production.
# Leave unset. Fake pay is on by default in development only.
# PITCH402_ALLOW_FAKE_PAY=

# ---------------------------------------------------------------------------
# Privy — the buyer side. Only the agent scripts in agent/ use these; the
# Pitch402 API itself never needs them. Get both from dashboard.privy.io.
# ---------------------------------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Filled in by `npm run agent:setup`. The agent wallet that pays for spots.
PITCH402_AGENT_WALLET_ID=
PITCH402_AGENT_ADDRESS=

# Per-payment ceiling in whole USDC, enforced twice: client-side by x402 spend
# controls, and inside Privy's enclave by the wallet policy. Default 10.
# PITCH402_AGENT_MAX_USDC=10

# ---------------------------------------------------------------------------
# Spotify — the curator side. Buying a spot writes the track to the curator's
# own playlist, so without these a sale is recorded but nothing is placed.
# Create an app at https://developer.spotify.com/dashboard and register the
# redirect URI below on it, exactly as written.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a redirect URI registered on the Spotify app, character for
# character. Defaults to <request origin>/api/v1/curator/spotify/callback.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/v1/curator/spotify/callback

# Set to 1 to create public playlists. Playlists we create are private by default.
# SPOTIFY_PLAYLIST_PUBLIC=1

# ---------------------------------------------------------------------------
# Supabase — persistence. Without these, everything runs in memory and dies on
# restart, which is fine locally and wrong anywhere that has more than one
# server instance (Vercel). Create a project, run supabase/schema.sql in the
# SQL editor, then paste both values here.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It is server-only and
# must never be exposed to a browser or committed.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
